# {{ ansible_managed }}

JAVA_HOME={{ wildfly_systemd_java_home  | default(wildfly_rpm_java_home, true) }}
JAVA_OPTS='{{ wildfly_systemd_java_opts }}'
WILDFLY_BIND={{ wildfly_systemd_bind_addr }}
WILDFLY_BIND_MGMT={{ wildfly_systemd_bind_addr_management }}
WILDFLY_HOME={{ wildfly_systemd_config.home }}
JBOSS_PIDFILE={{ wildfly_systemd_config.selinux.pid_path }}/{{ wildfly_systemd_instance_name }}.pid
WILDFLY_SERVER_CONFIG={{ wildfly_systemd_instance_name }}.xml

WILDFLY_OPTS=-Djboss.bind.address.private={{ wildfly_systemd_bind_addr_private }} \
 -Djboss.default.multicast.address={{ wildfly_systemd_multicast_addr }} \
 -Djboss.server.config.dir={{ basedir }}/configuration/ \
 -Djboss.server.base.dir={{ basedir }} \
 -Djboss.tx.node.id={{ wildfly_systemd_node_id }} \
 -Djboss.node.name={{ wildfly_systemd_instance_name }} \
 -Djboss.socket.binding.port-offset={{ wildfly_systemd_port_range_offset }} \
 -Dwildfly.statistics-enabled={{ wildfly_systemd_statistics_enabled | lower }}

WILDFLY_YAML={% if wildfly_systemd_enable_yml_config and wildfly_systemd_yml_configs | length > 0 %}{{ wildfly_yml_configs_str }}{% endif %}
